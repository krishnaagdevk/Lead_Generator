generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  starter
  pro
  agency
}

enum WebsiteStatus {
  no_website
  broken
  live
  unknown
}

enum PipelineStage {
  new
  contacted
  replied
  negotiating
  won
  lost
}

enum BestContact {
  email
  phone
  social
}

enum SearchStatus {
  queued
  running
  done
  failed
}

enum CampaignStatus {
  draft
  scheduled
  running
  done
  paused
}

enum DraftStatus {
  pending
  sent
  failed
  skipped
}

enum EmailLogStatus {
  sent
  opened
  replied
  bounced
  unsubscribed
}

enum SuppressionReason {
  unsubscribe
  bounce
  manual
  spam_complaint
}

enum WarmupStatus {
  inactive
  active
  completed
}

model SmsLog {
  id        Int      @id @default(autoincrement())
  leadId    Int
  userId    Int
  message   String
  twilioSid String?
  status    String   @default("sent")  // "sent" | "failed"
  sentAt    DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Task {
  id          Int       @id @default(autoincrement())
  userId      Int
  leadId      Int?
  title       String
  description String?
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  lead        Lead?     @relation(fields: [leadId], references: [id])
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  keyHash   String   @unique
  keyPrefix String
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  passwordHash     String
  plan             Plan           @default(free)
  usageLeads       Int            @default(0)
  usageAiCalls     Int            @default(0)
  stripeCustomerId String?
  parentId         Int?
  role             String         @default("owner")
  createdAt        DateTime       @default(now())
  
  // Calendly & Integrations
  calendlyUrl      String?
  slackBotToken    String?
  slackChannelId   String?
  webhookUrl       String?
  webhookEnabled   Boolean        @default(false)
  
  // White-label branding
  brandName        String?
  brandLogo        String?
  brandColor       String?
  whiteLabel       Boolean        @default(false)
  
  parent           User?          @relation("TeamMembers", fields: [parentId], references: [id])
  teamMembers      User[]         @relation("TeamMembers")
  searchJobs       SearchJob[]
  leads            Lead[]
  emailAccounts    EmailAccount[]
  campaigns        Campaign[]
  suppressions     Suppression[]
  savedSearches    SavedSearch[]
  smsLogs          SmsLog[]
  tasks            Task[]
  apiKeys          ApiKey[]
}

model SearchJob {
  id           Int          @id @default(autoincrement())
  userId       Int
  businessType String
  geoQuery     Json
  status       SearchStatus @default(queued)
  totalFound   Int          @default(0)
  error        String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?
  user         User         @relation(fields: [userId], references: [id])
  leads        Lead[]
}

enum EmailVerifiedStatus {
  unverified
  valid
  invalid
  catchall
}

model Lead {
  id                  Int                 @id @default(autoincrement())
  userId              Int
  searchJobId         Int
  placeId             String
  name                String
  category            String?
  address             String?
  phone               String?
  email               String?
  emailVerifiedStatus EmailVerifiedStatus @default(unverified)
  emailVerifiedAt     DateTime?
  leadScore           Int                 @default(0)
  websiteUrl          String?
  websiteStatus       WebsiteStatus       @default(unknown)
  socialLinks         Json?
  bestContact         BestContact?
  rating              Float?
  reviewCount         Int?
  mapsUrl             String?
  pipelineStage       PipelineStage       @default(new)
  notes               String?
  createdAt           DateTime            @default(now())
  
  // Enrichment fields
  enrichedAt          DateTime?
  enrichmentSource    String?     // "hunter" | "manual"
  decisionMakerName   String?
  decisionMakerTitle  String?
  decisionMakerLinkedIn String?
  
  // Domain expiry fields
  domainExpiryDate    DateTime?
  domainExpiresInDays Int?
  
  // Geolocation fields for heatmap
  lat  Float?
  lng  Float?
  
  // Review sentiment fields
  reviewSentiment    String?   // "positive" | "mixed" | "negative"
  reviewPainPoints   Json?     // string[] of pain points
  reviewPitchAngle   String?   // AI-suggested pitch angle
  
  // Deal tracking fields
  dealValue       Float?    // $ value of this deal (e.g. 2500.00)
  dealClosedAt    DateTime? // when was this deal marked Won
  dealNotes       String?   // additional deal notes
  
  user                User                @relation(fields: [userId], references: [id])
  searchJob           SearchJob           @relation(fields: [searchJobId], references: [id])
  emailDrafts         EmailDraft[]
  emailLogs           EmailLog[]
  enrollments         SequenceEnrollment[]
  smsLogs             SmsLog[]
  tasks               Task[]

  @@index([userId])
  @@index([searchJobId])
  @@index([placeId])
}

model EmailAccount {
  id                  Int          @id @default(autoincrement())
  userId              Int
  gmailAddress        String
  oauthTokenEncrypted String
  dailyLimit          Int          @default(100)
  dailySent           Int          @default(0)
  isDefault           Boolean      @default(false)
  lastResetAt         DateTime     @default(now())
  warmupStatus        WarmupStatus @default(inactive)
  warmupDay           Int          @default(1)
  warmupStartDate     DateTime?
  createdAt           DateTime     @default(now())
  user                User         @relation(fields: [userId], references: [id])
  campaigns           Campaign[]
}

model Suppression {
  id           Int               @id @default(autoincrement())
  userId       Int
  emailAddress String
  reason       SuppressionReason
  addedAt      DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, emailAddress])
}

enum EnrollmentStatus {
  active
  completed
  replied
  unsubscribed
  failed
}

model SequenceStep {
  id          Int       @id @default(autoincrement())
  campaignId  Int
  stepNumber  Int       // 1 = initial, 2 = first follow-up, etc.
  delayDays   Int       @default(3)  // days after previous step
  subject     String
  body        String
  createdAt   DateTime  @default(now())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrollments SequenceEnrollment[]
}

model SequenceEnrollment {
  id           Int              @id @default(autoincrement())
  leadId       Int
  campaignId   Int
  stepId       Int?             // currently executing step
  currentStep  Int              @default(1)
  status       EnrollmentStatus @default(active)
  nextSendAt   DateTime
  createdAt    DateTime         @default(now())
  lead         Lead             @relation(fields: [leadId], references: [id])
  campaign     Campaign         @relation(fields: [campaignId], references: [id])
  step         SequenceStep?    @relation(fields: [stepId], references: [id])

  @@unique([leadId, campaignId])
}

model Campaign {
  id              Int            @id @default(autoincrement())
  userId          Int
  emailAccountId  Int?
  name            String
  templateSubject String
  templateBody    String
  status          CampaignStatus @default(draft)
  scheduledAt     DateTime?
  followUpDays    Int?
  followUpCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  isSequence      Boolean        @default(false)
  steps           SequenceStep[]
  enrollments     SequenceEnrollment[]
  user            User           @relation(fields: [userId], references: [id])
  emailAccount    EmailAccount?  @relation(fields: [emailAccountId], references: [id])
  drafts          EmailDraft[]
  logs            EmailLog[]
}

model EmailDraft {
  id           Int         @id @default(autoincrement())
  campaignId   Int
  leadId       Int
  subject      String
  body         String
  editedByUser Boolean     @default(false)
  status       DraftStatus @default(pending)
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  campaign     Campaign    @relation(fields: [campaignId], references: [id])
  lead         Lead        @relation(fields: [leadId], references: [id])
  logs         EmailLog[]
}

model EmailLog {
  id                     Int            @id @default(autoincrement())
  draftId                Int
  campaignId             Int
  leadId                 Int
  gmailMessageId         String?
  trackingToken          String?        @unique
  status                 EmailLogStatus @default(sent)
  sentAt                 DateTime       @default(now())
  openedAt               DateTime?
  repliedAt              DateTime?
  bouncedAt              DateTime?
  replyBody              String?
  replyClassification    String?
  replySuggestedResponse String?
  draft                  EmailDraft     @relation(fields: [draftId], references: [id])
  campaign               Campaign       @relation(fields: [campaignId], references: [id])
  lead                   Lead           @relation(fields: [leadId], references: [id])

  @@index([trackingToken])
}

model PlacesCache {
  key       String   @id
  response  Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model JobQueue {
  id          Int       @id @default(autoincrement())
  taskType    String
  payload     Json
  status      String    @default("pending")
  error       String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, runAt])
}

model SavedSearch {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  businessType String
  geoQuery     Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

