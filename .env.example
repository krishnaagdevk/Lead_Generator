DATABASE_URL="postgresql://user:password@host:port/database"
JWT_SECRET="your-jwt-secret-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google APIs
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"
NEXT_PUBLIC_GOOGLE_MAPS_KEY="your_google_maps_api_key_here"
GOOGLE_GEOCODING_API_KEY="your_google_geocoding_api_key_here"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/email-accounts/callback"

# Groq
GROQ_API_KEY="your_groq_api_key_here"
GROQ_API_URL="https://api.groq.com/openai/v1"

# NaraRouter / Agent model (NaraRouter model name, e.g. mistral-large)
NARA_ROUTER_KEYS=""
NARA_ROUTER_URL="https://router.naraya.ai/v1"
AGENT_MODEL="mistral-large"

# Bluesminds API (Agent Fallback)
BLUESMINDS_API_URL="https://api.bluesminds.com/v1"
BLUESMINDS_API_KEY=""
BLUESMINDS_MODEL="moonshotai/kimi-k2.6"

# Parameterized LLM Models lists
NARA_MODELS="mimo-v2.5-free,mistral-large,mistral-medium-3-5,tencent-hy3"
GROQ_MODELS="llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b"

# SerpAPI (fallback)
SERPAPI_KEY="your_serpapi_key_here"

